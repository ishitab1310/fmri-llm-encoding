#!/bin/bash
#SBATCH -A research
#SBATCH --job-name=llama_feat
#SBATCH --partition=u22
#SBATCH --gres=gpu:1
#SBATCH -c 10
#SBATCH --mem-per-cpu=4G
#SBATCH --time=6:00:00
#SBATCH --output=/home2/ishita/a3_project/logs/llama_features_%j.out
#SBATCH --error=/home2/ishita/a3_project/logs/llama_features_%j.err

echo "=== Llama-3.2-3B Feature Extraction (5 subjects per language) ==="
echo "Job $SLURM_JOB_ID on $SLURM_NODELIST $(date)"

module load u22/cuda/12.4
source /home2/ishita/miniconda3/etc/profile.d/conda.sh
conda activate a3_llada

mkdir -p /scratch/ishita/hf_cache
export HF_HOME=/scratch/ishita/hf_cache
export TRANSFORMERS_CACHE=/scratch/ishita/hf_cache

echo "Model dir: /share1/ishita/llama_model"
ls /share1/ishita/llama_model

# =============================================================================
# ACTIVE: N  subjects per language (pod-agreed subset n=5)
# =============================================================================
python3 /home2/ishita/a3_project/scripts/extract_features_llama.py \
    --model_dir  /share1/ishita/llama_model \
    --data_dir   /share1/ishita/ds003643 \
    --feat_dir   /home2/ishita/features_llama \
    --langs      EN FR CN \
    --subjects   sub-EN057 sub-EN058 sub-EN059 sub-EN061 sub-EN062 \
                 sub-FR001 sub-FR002 sub-FR003 sub-FR004 sub-FR005 \
                 sub-CN001 sub-CN002 sub-CN003 sub-CN004 sub-CN005

echo "Done $(date)"


# =============================================================================
# ALL SUBJECTS — full ds003643 dataset (49 EN, 28 FR, 35 CN)
