#!/bin/bash
#SBATCH -A research
#SBATCH --job-name=llada_feat
#SBATCH --partition=u22
#SBATCH --gres=gpu:1
#SBATCH -c 10
#SBATCH --mem-per-cpu=4G
#SBATCH --time=10:00:00
#SBATCH --output=/home2/ishita/a3_project/logs/llada_%j.out
#SBATCH --error=/home2/ishita/a3_project/logs/llada_%j.err

echo "Job $SLURM_JOB_ID on $SLURM_NODELIST $(date)"
module load u22/cuda/12.4
source /home2/ishita/miniconda3/etc/profile.d/conda.sh
conda activate a3_llada

export HF_HOME=/home2/ishita/hf_cache
export TRANSFORMERS_CACHE=/home2/ishita/hf_cache
export HF_MODULES_CACHE=/home2/ishita/hf_cache/modules
mkdir -p /home2/ishita/hf_cache/modules

SCRATCH=/scratch/ishita/$SLURM_JOB_ID
mkdir -p $SCRATCH/data/annotation
S3="https://s3.amazonaws.com/openneuro.org/ds003643"

echo "=== Downloading annotation ==="
for lang in EN FR CN; do
    mkdir -p $SCRATCH/data/annotation/$lang
    wget -q "$S3/annotation/$lang/lpp${lang}_word_information.csv" \
        -O "$SCRATCH/data/annotation/$lang/lpp${lang}_word_information.csv" &
done
wait
echo "Annotation: $(find $SCRATCH/data/annotation -type f | wc -l) files"

echo "=== Downloading BOLD in parallel ==="
download_subject() {
    sub=$1
    if [[ $sub == *EN* ]]; then task="lppEN"
    elif [[ $sub == *FR* ]]; then task="lppFR"
    else task="lppCN"; fi
    mkdir -p $SCRATCH/data/derivatives/$sub/func
    for fname in $(aws s3 ls --no-sign-request \
        s3://openneuro.org/ds003643/derivatives/$sub/func/ \
        | awk '{print $4}' | grep "\.nii\.gz$"); do
        wget -q -c "$S3/derivatives/$sub/func/$fname" \
            -O "$SCRATCH/data/derivatives/$sub/func/$fname"
    done
    n=$(ls $SCRATCH/data/derivatives/$sub/func/*.nii.gz 2>/dev/null | wc -l)
    echo "  $sub: $n BOLD files"
}
export -f download_subject
export SCRATCH S3

# Download all 15 subjects in parallel (5 at a time)
for sub in sub-EN057 sub-EN058 sub-EN059 sub-EN061 sub-EN062 \
           sub-FR001 sub-FR002 sub-FR003 sub-FR004 sub-FR005 \
           sub-CN001 sub-CN002 sub-CN003 sub-CN004 sub-CN005; do
    download_subject $sub &
    # Limit to 5 parallel downloads
    while [ $(jobs -r | wc -l) -ge 5 ]; do sleep 2; done
done
wait

echo "Total BOLD: $(find $SCRATCH/data/derivatives -name '*.nii.gz' | wc -l)"

echo "=== Creating output dirs ==="
for lang in EN FR CN; do
    for sub in sub-EN057 sub-EN058 sub-EN059 sub-EN061 sub-EN062 \
               sub-FR001 sub-FR002 sub-FR003 sub-FR004 sub-FR005 \
               sub-CN001 sub-CN002 sub-CN003 sub-CN004 sub-CN005; do
        mkdir -p /home2/ishita/features_llada/$lang/$sub
    done
done

echo "=== Running extraction ==="
python3 /home2/ishita/a3_project/scripts/extract_features.py \
    --model_dir /home2/ishita/llada_model \
    --data_dir  $SCRATCH/data \
    --feat_dir  /home2/ishita/features_llada \
    --langs EN FR CN \
    --subjects \
        sub-EN057 sub-EN058 sub-EN059 sub-EN061 sub-EN062 \
        sub-FR001 sub-FR002 sub-FR003 sub-FR004 sub-FR005 \
        sub-CN001 sub-CN002 sub-CN003 sub-CN004 sub-CN005

echo "Done $(date)"
